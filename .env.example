# TRADING MODE: backtest, paper, testnet, live
MODE=paper

# SYMBOL AND TIMEFRAME
SYMBOL=BTC/USDT
TIMEFRAME=1h

# CAPITAL AND RISK
INITIAL_CAPITAL=10000
RISK_PER_TRADE=0.01

# RISK LIMITS
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.10
MAX_POSITIONS=3

# EXCHANGE CONFIGURATION (never commit actual keys)
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# EXCHANGE SETTINGS
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005

# DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/btc_algo

# REDIS
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# LOGGING
LOG_LEVEL=INFO
LOG_FORMAT=json

# ENABLE LIVE TRADING (requires explicit confirmation)
ENABLE_LIVE_TRADING=false

# STRATEGY SELECTION
STRATEGY=ema_rsi
BACKTEST_START=2023-01-01
BACKTEST_END=2024-01-01
