# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
LOG_FORMAT=json

# Trading Mode: backtest, paper, testnet, live
MODE=paper

# Symbol and Timeframe
SYMBOL=BTC/USDT
TIMEFRAME=1h

# Capital and Risk Management
INITIAL_CAPITAL=10000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.10
MAX_POSITIONS=3
TAKE_PROFIT_RATIO=0.02
STOP_LOSS_RATIO=0.01

# Risk Limits
MAX_LEVERAGE=2
MIN_TRADE_SIZE=100
MAX_TRADE_SIZE=5000
COOLDOWN_SECONDS=60

# Exchange Configuration (never commit actual keys)
EXCHANGE=binance
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here
EXCHANGE_TESTNET=false

# Exchange Settings
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005
ORDER_TIMEOUT=30

# Database Configuration
DATABASE_DRIVER=postgresql
DATABASE_USER=btc_algo
DATABASE_PASSWORD=your_secure_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=btc_algo
DATABASE_URL=postgresql://btc_algo:your_secure_password@localhost:5432/btc_algo
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true
API_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=1000
WS_MESSAGE_QUEUE_SIZE=100

# Backtest Configuration
BACKTEST_START=2023-01-01
BACKTEST_END=2024-01-01
BACKTEST_DATA_SOURCE=binance
BACKTEST_COMMISSION=0.001

# Strategy Configuration
STRATEGY=ema_rsi
EMA_FAST_PERIOD=12
EMA_SLOW_PERIOD=26
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Live Trading Safety
ENABLE_LIVE_TRADING=false
LIVE_TRADING_DRY_RUN=true
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Monitoring and Observability
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Email Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL=alerts@example.com

# Data Retention
TRADE_HISTORY_DAYS=365
PERFORMANCE_METRICS_DAYS=90
LOG_RETENTION_DAYS=30
